{
  "name": "StealATung",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "DevCameraOcclusionMode": "Zoom"
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false,
        "FallenPartsDestroyHeight": -200
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap"
      }
    }
  }
}
